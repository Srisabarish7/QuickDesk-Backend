{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "QuickDesk": "Your-Connection-String-Here"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId", "WithProperty" ],
    "Properties": {
      "Application": "QuickDesk.Worker"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [trace_id:{trace_id}] [{MachineName}] [{ThreadId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "QuickDeskWorker": {
    "BatchSize": 50,
    "PollingIntervalMs": 500,
    "MaxDegreeOfParallelism": 4,
    "StuckItemTimeoutMinutes": 30,
    "RetryBaseDelaySeconds": 2,
    "ChannelCapacity": 1000,
    "MaxRetryAttempts": 5,
    "ThroughputLogging": {
      "Enabled": true,
      "LogAfterItemsProcessed": 100
    }
  }
}
